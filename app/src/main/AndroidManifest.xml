<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Device only (docs/PLAN.md §9): Cadence must never be able to reach the network.
      These remove the permissions even if a library manifest tries to add them.
      CI also checks the built APK.
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
      allowBackup=false: no Google cloud backup (API 30 and below).
      dataExtractionRules: no cloud backup or device-to-device transfer (API 31+),
      which allowBackup alone doesn't block. The database key only exists in this
      device's Keystore, so a copied database would be useless anyway.
    -->
    <application
        android:name=".CadenceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cadence"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.Cadence.Starting"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Launcher entries: Cadence's own icon, or a discreet one ("Planner", a plain notepad).
          Exactly one is enabled; Settings → App icon switches them (docs/PLAN.md Phase 7).
          The names are used by feature:settings (AppIcons), so keep them in sync.
        -->
        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherDiscreet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_discreet"
            android:label="@string/app_name_discreet"
            android:roundIcon="@mipmap/ic_launcher_discreet"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
