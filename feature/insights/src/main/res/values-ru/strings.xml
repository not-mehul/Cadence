<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="insights_title">Обзор</string>

    <!-- Empty states -->
    <string name="insights_empty_title">Пока нечего показать</string>
    <string name="insights_empty_body">Отмечайте месячные, и здесь появится статистика вашего цикла.</string>
    <string name="insights_first_cycle_title">Идёт ваш первый цикл</string>
    <string name="insights_first_cycle_body">Статистика появится, когда вы отметите начало следующих месячных.</string>

    <!-- Summary tiles -->
    <string name="insights_average_cycle">Средний цикл</string>
    <string name="insights_average_period">Средние месячные</string>
    <string name="insights_variation">Разброс цикла</string>
    <string name="insights_prediction">Точность прогноза</string>
    <string name="insights_range">%1$s – %2$s</string>
    <string name="insights_shortest_to_longest">От короткого до длинного</string>
    <string name="insights_plus_minus">± %1$s</string>
