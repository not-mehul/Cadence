    <!-- Phase cards -->
    <string name="phase_menstrual">Menstrual phase</string>
    <string name="phase_menstrual_body">Hormone levels are at their lowest and energy may dip. Rest, warmth and gentle movement can help with cramps.</string>
    <string name="phase_follicular">Follicular phase</string>
    <string name="phase_follicular_body">Estrogen rises as your body prepares to release an egg. Many people notice their energy and mood lifting.</string>
    <string name="phase_ovulatory">Ovulatory phase (estimate)</string>
    <string name="phase_ovulatory_body">Around your estimated ovulation. Some people notice clearer, stretchier discharge or a twinge on one side. This is an estimate and can\'t be used to prevent pregnancy.</string>
    <string name="phase_luteal">Luteal phase</string>
    <string name="phase_luteal_body">Progesterone rises after ovulation. In the days before your period you might notice bloating, tender breasts or mood changes.</string>
    <string name="phase_birth_control">Hormonal birth control</string>
    <string name="phase_birth_control_body">Most hormonal birth control prevents ovulation, so Cadence doesn\'t show cycle phases or ovulation estimates. You can still log bleeding and see when to expect it.</string>
    <string name="phase_late">Running late</string>
    <string name="phase_late_body">Cycles vary for many reasons, including stress, illness, travel and changes in weight or exercise. If you might be pregnant, a test can tell you for sure.</string>
    <string name="phase_welcome">How Cadence works</string>
    <string name="phase_welcome_body">Each time you log a period, Cadence learns your rhythm. After two cycles, predictions are based on your own history.</string>
</resources>
